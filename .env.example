# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FINNHUB_API_KEY: Market data WebSocket API key from finnhub.io
FINNHUB_API_KEY=

# FMP_API_KEY: Financial Modeling Prep API key
FMP_API_KEY=

# FRED_API_KEY: St Louis Fed Macro Data API key
FRED_API_KEY=

# ALPACA_API_KEY: Alpaca API Key ID (for live market data)
ALPACA_API_KEY=

# ALPACA_SECRET_KEY: Alpaca API Secret Key (for live market data)
ALPACA_SECRET_KEY=

# VITE_RECAPTCHA_V3_SITE_KEY: ReCAPTCHA V3 Site Key for Firebase App Check
VITE_RECAPTCHA_V3_SITE_KEY=

# STRIPE_SECRET_KEY: Stripe secret key (sk_test_... to test, sk_live_... in production)
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: signing secret (whsec_...) of the endpoint https://quantrih.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# FIREBASE_SERVICE_ACCOUNT: Firebase service account JSON (one line, or base64). Lets the server
# check who is signed in and write the plan to users/{uid}/profiles/subscription.
FIREBASE_SERVICE_ACCOUNT=

# Optional: Stripe price ids. When empty, prices are found by lookup key
# (quantrih_premium_monthly, quantrih_premium_yearly, quantrih_pro_monthly, quantrih_pro_yearly)
# and created automatically on the first checkout (15 EUR, 150 EUR, 40 EUR, 400 EUR).
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
YOUTUBE_API_KEY=
