# Postgres hébergé en Europe (Neon Francfort, Supabase eu-central…)
DATABASE_URL=postgres://qo:qo@localhost:5432/quantrih_office
# Secret de session et de chiffrement : npx auth secret
AUTH_SECRET=
# URL publique du site (liens d'invitation)
APP_URL=http://localhost:3000
# Envoi des e-mails (facultatif en local : les liens sont alors affichés dans le back-office)
RESEND_API_KEY=
MAIL_FROM="Quantrih Office <bonjour@quantrih-office.be>"
MAIL_TO_TEAM=bonjour@quantrih-office.be
# Compte administrateur créé par npm run db:seed
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
