{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public and private user profile data.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "nationality": { "type": "string" },
        "residenceCountry": { "type": "string" },
        "phone": { "type": "string" },
        "phoneCountryCode": { "type": "string" },
        "phoneCountryFlag": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "username": { "type": "string" },
        "company": { "type": "string" },
        "firmType": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "status": { "type": "string" },
        "emailVerified": { "type": "boolean" },
        "canChangePassword": { "type": "boolean" },
        "twoFactorEnabled": { "type": "boolean" },
        "twoFactorMethod": { "type": "string" },
        "passwordLastChangedAt": { "type": "string" },
        "securityNotificationsEnabled": { "type": "boolean" },
        "role": {
          "type": "string",
          "enum": ["user", "admin"]
        }
      },
      "required": ["updatedAt"]
    },
    "BacktestConfig": {
      "title": "BacktestConfig",
      "description": "Saved configuration for a portfolio backtest",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the saved backtest profile"
        },
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this backtest"
        },
        "startYear": {
          "type": "number"
        },
        "endYear": {
          "type": "number"
        },
        "initialAmount": {
          "type": "number"
        },
        "cashflowAmount": {
          "type": "number",
          "description": "Recurring cash flow amount"
        },
        "rebalancing": {
          "type": "string",
          "enum": ["annual", "none"]
        },
        "numPortfolios": {
          "type": "number"
        },
        "allocRows": {
          "type": "array"
        },
        "portNames": {
          "type": "array"
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "userId",
        "startYear",
        "endYear",
        "initialAmount",
        "cashflowAmount",
        "rebalancing",
        "numPortfolios",
        "allocRows",
        "portNames",
        "createdAt",
        "updatedAt"
      ]
    },
    "InvestorProfile": {
      "title": "Investor Profile",
      "description": "Investor suitability and KYC data for portfolio management.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "dob": { "type": "string" },
        "taxCountry": { "type": "string" },
        "taxState": { "type": "string" },
        "taxCity": { "type": "string" },
        "tin": { "type": "string" },
        "isUsPerson": { "type": "boolean" },
        "employmentStatus": { "type": "string" },
        "professionType": { "type": "string" },
        "incomeStability": { "type": "string" },
        "incomeSourcesCount": { "type": "string" },
        "incomeFrequency": { "type": "string" },
        "monthlySavingsCapacity": { "type": "string" },
        "approxFixedChargesPct": { "type": "string" },
        "annualIncomeRange": { "type": "string" },
        "financialSituationStableForInvesting": { "type": "boolean" },
        "dependentOnSingleIncome": { "type": "boolean" },
        "hasIncomeDropLast12m": { "type": "boolean" },
        "approxNetWorth": { "type": "string" },
        "financialWealthEstimate": { "type": "string" },
        "realEstateWealthEstimate": { "type": "string" },
        "businessWealthEstimate": { "type": "string" },
        "immediatelyAvailableLiquidity": { "type": "string" },
        "totalOutstandingDebt": { "type": "string" },
        "debtServiceRatio": { "type": "string" },
        "amountToInvestNow": { "type": "string" },
        "investableSharePct": { "type": "string" },
        "primarySourceOfFunds": { "type": "string" },
        "secondarySourcesOfFunds": { "type": "array" },
        "fundsOwnership": { "type": "string" },
        "depositFrequency": { "type": "string" },
        "capitalTaxStatus": { "type": "string" },
        "overallExperienceYears": { "type": "string" },
        "investmentFrequency": { "type": "string" },
        "tradesPerYearRange": { "type": "string" },
        "productsTraded": { "type": "array" },
        "priorPlatformsUsed": { "type": "array" },
        "ordersExecutedTypes": { "type": "array" },
        "understandsPerfVsVolatility": { "type": "string" },
        "experiencedMajorDrawdown": { "type": "string" },
        "selfAssessedLevel": { "type": "string" },
        "primaryObjective": { "type": "string" },
        "timeHorizon": { "type": "string" },
        "maxDrawdownAcceptable": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles identified by UID."
    },
    "/users/{userId}/backtests/{backtestId}": {
      "schema": "BacktestConfig",
      "description": "User specific backtest configurations"
    },
    "/users/{userId}/profiles/{profileId}": {
      "schema": "InvestorProfile",
      "description": "User specific investor suitability profiles"
    }
  }
}
